@page "/authority-login"
@rendermode InteractiveServer

<div class="login-container">
    <div class="card login-card">
        <div class="header-section">
            <h2>Authority Login</h2>
            <p class="note">Welcome back, Super Admin! Please enter your credentials.</p>
        </div>

        <EditForm Model="this" OnValidSubmit="HandleLogin">
            <div class="form-group">
                <label>Authority Type *</label>
                <select class="fullwidth aspNet-DropDownList" @bind="AuthorityType" required>
                    <option value="">-- Select Authority --</option>
                    <option value="School">School</option>
                    <option value="College">College</option>
                    <option value="University">University</option>
                </select>
            </div>

            <div class="form-group">
                <label>Admin E-mail Address *</label>
                <input type="email" class="fullwidth" placeholder="admin@institution.edu" @bind="AdminEmail" required />
            </div>

            <div class="form-group">
                <label>Password *</label>
                <div class="password-wrapper">
                    <!-- Dynamic input type based on ShowPassword boolean -->
                    <input type="@(ShowPassword ? "text" : "password")" class="fullwidth password-field" placeholder="Enter your password" @bind="Password" required />
                    <button type="button" class="toggle-password-btn" @onclick="TogglePasswordVisibility">
                        @(ShowPassword ? "Hide" : "Show")
                    </button>
                </div>
            </div>

            <div class="button-container">
                <button type="submit" class="btn btn-primary fullwidth-btn">Login to Dashboard</button>
            </div>

            @if (!string.IsNullOrEmpty(StatusMessage))
            {
                <!-- Text turns red if it's an error, otherwise neon for success -->
                <div class="status-msg" style="color: @(StatusMessage.Contains("Invalid") || StatusMessage.Contains("Error") ? "#ff6b6b" : "var(--neon)");">
                    @StatusMessage
                </div>
            }
        </EditForm>
    </div>
</div>

@code {
    // Data Bindings
    private string AuthorityType { get; set; } = "";
    private string AdminEmail { get; set; } = "";
    private string Password { get; set; } = "";

    // State Variables
    private bool ShowPassword { get; set; } = false;
    private string StatusMessage { get; set; } = "";

    // Toggle password visibility
    private void TogglePasswordVisibility()
    {
        ShowPassword = !ShowPassword;
    }

    private void HandleLogin()
    {
        // Basic validation
        if (string.IsNullOrWhiteSpace(AuthorityType) || string.IsNullOrWhiteSpace(AdminEmail) || string.IsNullOrWhiteSpace(Password))
        {
            StatusMessage = "Error: Please fill in all required fields.";
            return;
        }

        // TODO: Map to real database authentication logic
        if (Password == "admin123") // Placeholder check
        {
            StatusMessage = $"Success! Redirecting to {AuthorityType} Super Admin dashboard...";
            // NavigationManager.NavigateTo("/authority/dashboard");
        }
        else
        {
            StatusMessage = "Error: Invalid E-mail Address or Password.";
        }
    }
}